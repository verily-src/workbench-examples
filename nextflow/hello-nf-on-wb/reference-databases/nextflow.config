// Keep the same local, Docker, and Workbench setup as the greeting pipeline.
includeConfig '../nextflow.config'

params {
    reference = "${projectDir}/data/tiny.fasta"
    reference_sha256 = 'a41fa433516c3142e85e7a703935dd79aa41c4a50050f55e3a65934a5d94a3bf'
    annotations = "${projectDir}/data/tiny.csv"
    annotations_sha256 = '569a76867b875e41090a5060947893073078923bcb82c294a2d3719a0db113dc'
    outdir = 'results/reference-databases'
}

// This example needs Python, even though the greeting processes do not.
process {
    withName: summarizeReference {
        container = 'python:3.12-slim'
    }
}

profiles {
    workbench {
        workDir = "${env('NF_WORK_BUCKET')}/hello-nf-on-wb/reference-scratch"
    }
}
