{
  "name": "Nextflow on Workbench",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "shutdownAction": "none",
  "workspaceFolder": "/home/jupyter/repos/hello-nf-on-wb",
  "remoteUser": "root",
  "postCreateCommand": [
    "/opt/workbench/startupscript/post-startup.sh",
    "jupyter",
    "/home/jupyter",
    "${templateOption:cloud}",
    "${templateOption:login}"
  ],
  "postStartCommand": [
    "/opt/workbench/startupscript/remount-on-restart.sh",
    "jupyter",
    "/home/jupyter",
    "${templateOption:cloud}",
    "${templateOption:login}"
  ],
  "features": {
    "ghcr.io/dhoeric/features/google-cloud-cli@sha256:fa5d894718825c5ad8009ac8f2c9f0cea3d1661eb108a9d465cba9f3fc48965f": {}
  },
  "customizations": {
    "workbench": {
      "opens": {
        "extensions": [".nf", ".config", ".sh", ".md", ".csv", ".yaml", ".yml", ".json"],
        "fileUrlSuffix": "/lab/tree/{path}",
        "folderUrlSuffix": "/lab/tree/{path}"
      }
    }
  }
}
