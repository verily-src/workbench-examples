/*
 * Select standard/docker locally, workbench_managed in Workflows, or workbench
 * for direct `wb nextflow` execution. Only the direct CLI profile reads the
 * terminal environment for Batch infrastructure settings.
 */
manifest {
    nextflowVersion = '!>=25.04.0'
}

params {
    input = "${projectDir}/data/greetings.csv"
    outdir = 'results'
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        process.container = 'debian:stable-slim'
    }

    // Workbench supplies executor, project, region, identity, network and workDir.
    // Keep this profile independent of environment variables in a user's app.
    workbench_managed {
        process.container = 'debian:stable-slim'
        process.cpus = 1
        process.memory = '1 GB'
    }

    // Direct CLI only. wb injects GOOGLE_* and PROJECT_DEFAULT_REGION.
    workbench {
        process.executor = 'google-batch'
        process.container = env('NF_CONTAINER') ?: 'debian:stable-slim'
        process.cpus = 1
        process.memory = '1 GB'
        workDir = env('NF_WORK_BUCKET') ? "${env('NF_WORK_BUCKET')}/hello-nf-on-wb/scratch" : null
        google.project = env('GOOGLE_CLOUD_PROJECT')
        google.location = env('NF_REGION') ?: env('PROJECT_DEFAULT_REGION')
        google.batch.serviceAccountEmail = env('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress = true
        google.batch.network = 'global/networks/network'
        google.batch.subnetwork = "regions/${env('NF_REGION') ?: env('PROJECT_DEFAULT_REGION')}/subnetworks/subnetwork"
    }
}
