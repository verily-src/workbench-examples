/*
 * Pipeline configuration.
 *
 * main.nf never mentions where it runs. Everything about *where* and *how* a run
 * executes lives in the profiles below, so the same code runs unchanged on a
 * laptop, in a local Docker container, or on Verily Workbench via Google Batch.
 * Select one with `-profile <name>`.
 */

params {
    input  = 'data/greetings.csv'
    outdir = 'results'
}

profiles {

    // Local machine, no container. Needs echo/tr/cat (any shell). First run.
    standard {
        process.executor = 'local'
    }

    // Local machine, inside a container. Requires Docker to be running.
    docker {
        process.executor  = 'local'
        docker.enabled    = true
        process.container = 'debian:stable-slim'
    }

    // Verily Workbench via Google Batch. Every workspace-specific value is read
    // from an environment variable with env('...') -- 12-Factor "config in the
    // environment" -- so nothing here is hardcoded. Populate those variables as
    // shown in the README before launching. env('NAME') (not "$NAME" or a
    // top-level def) is required by Nextflow's strict config parser.
    workbench {
        process.executor      = 'google-batch'
        process.container     = env('NF_CONTAINER') ?: 'debian:stable-slim'
        process.machineType   = 'e2-small'
        process.errorStrategy = { task.exitStatus == 50001 ? 'retry' : 'terminate' }
        process.maxRetries    = 3

        workDir = "${env('NF_WORK_BUCKET')}/hello-nf-on-wb/scratch"

        google.project  = env('GOOGLE_CLOUD_PROJECT')
        google.location = env('NF_REGION') ?: 'us-central1'

        google.batch.serviceAccountEmail = env('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress   = true
        google.batch.network    = "projects/${env('GOOGLE_CLOUD_PROJECT')}/global/networks/network"
        google.batch.subnetwork = "projects/${env('GOOGLE_CLOUD_PROJECT')}/regions/${env('NF_REGION') ?: 'us-central1'}/subnetworks/subnetwork"
        google.batch.maxSpotAttempts = 5

        google.httpConnectTimeout = '10m'
        google.httpReadTimeout    = '10m'

        executor.pollInterval      = '30s'
        executor.queueStatInterval = '2m'
    }
}
