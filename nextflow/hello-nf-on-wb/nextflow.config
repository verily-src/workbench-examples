/*
 * Pipeline configuration.
 *
 * main.nf never mentions where it runs. Everything about *where* and *how* a run
 * executes lives in the profiles below, so the same code runs unchanged on a
 * laptop, in a local Docker container, or on Verily Workbench via Google Batch.
 * Select one with `-profile <name>`.
 */

params {
    // Default input is the small bundled sample, anchored to projectDir (the
    // directory containing main.nf) -- NOT a bare relative path. A relative
    // 'data/greetings.csv' resolves against the *launch* directory, which on
    // Workbench is not the pipeline folder, and fails with "No such file".
    // projectDir always points at the checked-out pipeline, so the sample works
    // locally and as a zero-setup smoke test on Workbench.
    //
    // Real runs override this with data staged in a bucket:
    //   --input gs://<bucket>/inputs/greetings.csv --outdir gs://<bucket>/...
    // (see README). Production inputs are large and live in the bucket, not git.
    input  = "${projectDir}/data/greetings.csv"
    outdir = 'results'
}

profiles {

    // Local machine, no container. Needs echo/tr/cat (any shell). First run.
    standard {
        process.executor = 'local'
    }

    // Local machine, inside a container. Requires Docker to be running.
    docker {
        process.executor  = 'local'
        docker.enabled    = true
        process.container = 'debian:stable-slim'
    }

    // Verily Workbench via Google Batch. This mirrors the example profile in the
    // Workbench support docs (https://support.workbench.verily.com/docs/guides/cli/cli_nextflow/),
    // kept env-driven so nothing workspace-specific is hardcoded. env('NAME')
    // (not "$NAME" or a top-level def) is required by Nextflow's strict config
    // parser. Populate the variables as shown in the README before launching.
    workbench {
        process.executor  = 'google-batch'
        process.container = env('NF_CONTAINER') ?: 'debian:stable-slim'

        // Google Batch needs to know the VM size. Either set machineType
        // explicitly (as here), or set process cpus/memory and let Batch derive
        // a machine type. This example is tiny, so it pins the smallest type.
        process.machineType = 'e2-small'

        workDir = "${env('NF_WORK_BUCKET')}/hello-nf-on-wb/scratch"

        // Route workflow logs to the bucket (Batch on Workbench does not surface
        // them otherwise). This is consumed by the `wb nextflow` wrapper; plain
        // `nextflow` warns that it is unrecognized. Trailing slash required.
        logsPath = "${env('NF_WORK_BUCKET')}/hello-nf-on-wb/logs/"

        google.project  = env('GOOGLE_CLOUD_PROJECT')
        google.location = env('NF_REGION') ?: 'us-central1'

        google.batch.serviceAccountEmail = env('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress   = true
        google.batch.network    = 'global/networks/network'
        google.batch.subnetwork = "regions/${env('NF_REGION') ?: 'us-central1'}/subnetworks/subnetwork"
    }
}
