/*
 * Pipeline configuration.
 *
 * main.nf never mentions where it runs. Everything about *where* and *how* a run
 * executes lives in the profiles below, so the same code runs unchanged on a
 * laptop, in a local Docker container, or on Verily Workbench via Google Batch.
 * Select one with `-profile <name>`.
 */

params {
    // Default input is the small bundled sample, anchored to projectDir (the
    // directory containing main.nf) -- NOT a bare relative path. A relative
    // 'data/greetings.csv' resolves against the *launch* directory, which on
    // Workbench is not the pipeline folder, and fails with "No such file".
    // projectDir always points at the checked-out pipeline, so the sample works
    // locally and on Workbench. Override with your own data staged in a bucket:
    //   --input gs://<bucket>/inputs/greetings.csv (see README).
    input  = "${projectDir}/data/greetings.csv"
    outdir = 'results'

    // Settings for the verily_workbench (Google Batch) profile. Supplied as
    // params -- not environment variables -- so they work identically on the CLI
    // (`wb nextflow`) and in the Workflows UI. Resolve a bucket resource to its
    // gs:// path with `wb resource resolve` (see README); never hardcode a
    // physical bucket name.
    location  = 'us-central1'          // Batch region; must match your workspace
    work_dir  = null                   // gs:// path for Nextflow's work directory
    container = 'debian:stable-slim'   // task image; swap for an Artifact Registry image
}

// Task resource requests belong on the processes, not the executor profile (this
// is the nf-core `conf/base.config` pattern) -- Google Batch derives the VM type
// from them, and they apply on every executor. This example is tiny and uses one
// default; a real pipeline sets them per process, e.g. via nf-core resource
// labels with `{ 6.GB * task.attempt }`-style retry scaling.
process {
    cpus   = 1
    memory = '2 GB'
}

profiles {

    // Local machine, no container. Needs echo/tr/cat (any shell). First run.
    standard {
        process.executor = 'local'
    }

    // Local machine, inside a container. Requires Docker to be running.
    docker {
        process.executor  = 'local'
        docker.enabled    = true
        process.container = params.container
    }

    // Verily Workbench via Google Batch. This mirrors the example profile in the
    // Workbench support docs (https://support.workbench.verily.com/docs/guides/cli/cli_nextflow/).
    // Everything the user controls is a param (location/work_dir/container/outdir)
    // so it works the same on the CLI and in the UI; only the project and service
    // account are read from the environment, because Workbench injects those
    // automatically on both. env('NAME') is the strict-parser-safe way to read
    // an OS env var.
    verily_workbench {
        process.executor  = 'google-batch'
        process.container = params.container

        workDir = params.work_dir

        google.project  = env('GOOGLE_CLOUD_PROJECT')
        google.location = params.location

        google.batch.serviceAccountEmail = env('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress   = true
        // VM boot disk (the disk setting that belongs in a Batch profile -- cf.
        // nf-core googlebatch, which defaults to 100 GB for heavier pipelines).
        google.batch.bootDiskSize = '30 GB'
        google.batch.network    = 'global/networks/network'
        google.batch.subnetwork = "regions/${params.location}/subnetworks/subnetwork"
    }
}
