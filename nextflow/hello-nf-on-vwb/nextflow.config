params {
    // projectDir-anchored so the bundled sample resolves from any launch dir.
    input     = "${projectDir}/data/greetings.csv"
    outdir    = 'results'

    location  = 'us-central1'
    work_dir  = null
    container = 'debian:stable-slim'
}

// Task resources belong on the process, not the executor profile (the nf-core
// conf/base.config pattern); Google Batch sizes the VM from these.
process {
    cpus   = 1
    memory = '2 GB'
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        process.executor  = 'local'
        docker.enabled    = true
        process.container = params.container
    }

    verily_workbench {
        process.executor  = 'google-batch'
        process.container = params.container

        workDir = params.work_dir

        google.project  = env('GOOGLE_CLOUD_PROJECT')
        google.location = params.location

        google.batch.serviceAccountEmail = env('GOOGLE_SERVICE_ACCOUNT_EMAIL')
        google.batch.usePrivateAddress   = true
        google.batch.bootDiskSize        = '30 GB'
        google.batch.network             = 'global/networks/network'
        google.batch.subnetwork          = "regions/${params.location}/subnetworks/subnetwork"
    }
}
